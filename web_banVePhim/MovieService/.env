# Cấu hình IP Máy Vật Lý trong LAN
IP_MAY1=127.0.0.1
IP_MAY2=127.0.0.1
IP_MAY3=127.0.0.1

# Cấu hình Hạ tầng & Gateway (Host ở MÁY 1)
KAFKA_BOOTSTRAP_SERVERS=${IP_MAY1}:9092
GATEWAY_PORT=8080

# Cấu hình Frontend
VITE_GATEWAY_URL=http://${IP_MAY1}:8080

# Cấu hình Port cho từng Service
USER_SERVICE_PORT=8081
MOVIE_SERVICE_PORT=8082
BOOKING_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
